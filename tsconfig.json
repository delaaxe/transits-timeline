{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // Every part of `strict` except noImplicitAny, which is still being worked
    // through a directory at a time in tsconfig.strict.json. When that list
    // reaches src/ui, these collapse into "strict": true.
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
